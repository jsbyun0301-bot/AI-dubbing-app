# ─────────────────────────────────────────────
# API 키 설정
#
# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채워 주세요.
#   cp .env.example .env
#
# .env 는 .gitignore 에 포함되어 저장소에 올라가지 않습니다.
# ─────────────────────────────────────────────

# ElevenLabs — 음성 인식(STT) · 음성 합성(TTS)
# 발급: https://elevenlabs.io  →  Profile  →  API Keys
ELEVENLABS_API_KEY=

# Google Gemini — 스크립트 번역
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─────────────────────────────────────────────
# 사용량 제한 (선택 — 미설정 시 기본값 사용)
# ─────────────────────────────────────────────
# MAX_UPLOAD_MB=25
# MAX_TTS_CHARS=600
# MAX_PROMPT_CHARS=12000
# RATE_LIMIT_PER_HOUR=30
